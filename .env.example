# ===========================================
# Perplexity Clone — Environment Variables
# ===========================================
# Copy this file to Backend/.env for local development
# On Render, set these as environment variables in the dashboard

# MongoDB Connection
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Perplexity

# Authentication
JWT_SECRET=your_jwt_secret_here

# Google OAuth (kept for reference, currently unused)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Gmail (for Nodemailer)
GOOGLE_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# AI Services
GEMINI_API_KEY=your_gemini_api_key
MISTRAL_API_KEY=your_mistral_api_key
TAVELY_API_KEY=your_tavily_api_key

# URLs (set BACKEND_URL to your Render URL in production)
BACKEND_URL=http://localhost:3000
FRONTEND_URL=https://your-app.onrender.com
