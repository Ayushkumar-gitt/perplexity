# ===========================================
# Perplexity Clone — Environment Variables
# ===========================================
# Copy this file to Backend/.env for local development
# On Railway, set these as environment variables in the dashboard

# MongoDB Connection
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Perplexity

# Authentication
JWT_SECRET=your_jwt_secret_here

# Google OAuth (for Nodemailer)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_USER=your_email@gmail.com

# AI Services
GEMINI_API_KEY=your_gemini_api_key
MISTRAL_API_KEY=your_mistral_api_key
TAVELY_API_KEY=your_tavily_api_key

# Production URL (set after first Railway deploy)
FRONTEND_URL=https://your-app.up.railway.app
